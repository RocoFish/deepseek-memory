# Dependencies
node_modules/
*.tsbuildinfo

# `lib/` is deliberately NOT ignored: the compiled output is committed so a git
# install works without pnpm's build-script allowlist. Rebuild and commit it
# whenever `src/` changes — `npm run build`, then commit the result.

# Local inspection copies of published SDK type definitions (see README)
.sdk/

# Memory data must never be committed by accident. The project tier is meant to
# be shareable and gitignore-able by the *user*, in their own repository — this
# entry only protects this repo from a stray store during local testing.
.dsh-memory/

# Editor and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

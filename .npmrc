# Keep the funding/audit chatter that only adds noise to CI logs quiet.
fund=false
audit=false

# Hoisted linking, not pnpm's default isolated layout.
#
# Why this matters here: pnpm's default linker links packages with junctions, so a
# package is entered at `node_modules/<scope>/<name>/lib/index.js` rather than at
# its real `.pnpm` path, and Node's ESM resolver then looks for that package's own
# dependencies beside the junction instead of beside the real directory. The
# measured symptom was `@deepseek-ai/dsh-tools` failing to resolve its own
# `@deepseek-ai/schemastery` dependency even though pnpm had installed it.
#
# This only affects the *test* suite, which imports the real SDK to compare
# against. **The plugin's own `lib/` resolves nothing at install time** — it is
# self-contained by design; see the README section on bare imports.
node-linker=hoisted
